# The trusted signer key. ImmunityL1Resolver pins only the ADDRESS of this key;
# the gateway signs every response with it. REQUIRED. On fly: `fly secrets set
# SIGNER_PRIVATE_KEY=0x...`. NEVER commit a real key.
SIGNER_PRIVATE_KEY=0x...

# Base Sepolia RPC the gateway reads the L2 records from.
L2_RPC_URL=https://base-sepolia.g.alchemy.com/v2/C5BdobTzYALqWfs3wDc-I

# Live Base Sepolia contracts (override only if redeployed).
L2_REGISTRY_ADDRESS=0xded674AAbCe67B2cFe724c8c50c928830468E0cC
PUBLISHER_REGISTRAR_ADDRESS=0x762CF28bE7502CC99B6286076e9b4Fb71EE84002

# Signature TTL (seconds) and HTTP port.
TTL_SECONDS=300
PORT=8787
