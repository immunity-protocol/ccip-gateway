{
  "name": "immunity-ccip-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EIP-3668 CCIP-Read gateway for *.immunity.eth — reads records from the Base Sepolia ImmunityL2Registry and signs them for ImmunityL1Resolver.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "viem": "^2.52.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.11",
    "tsx": "^4.19.2",
    "typescript": "~5.8.0"
  }
}
